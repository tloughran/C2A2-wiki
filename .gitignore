# macOS
.DS_Store

# Obsidian — personal workspace state (content files are still tracked)
# Anchored with **/ so nested vaults (e.g. wiki/.obsidian/) are covered too
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json
**/.obsidian/graph.json

# FUSE mount artifacts (appear when files are open/edited over the mount)
.fuse_hidden*
**/.fuse_hidden*

# Nested projects (have their own repos)
claude-mem/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Node / build artifacts
node_modules/
dist/
build/
.vite/

# Editor
.vscode/
.idea/
*.swp
*~

# Secrets / env
.env
.env.local
*.key
*.pem

# Temporary / scratch
*.tmp
*.bak
*.bak*
*.tmpbak
scratch/

# Private — quarantined files that should never be in the public repo
.private/
# EXCEPTION (2026-07-20): .private/supabase/functions/cc-broker/index.ts is tracked
# despite this rule, via `git add -f`. It is the ONLY copy of the voice guide's Edge
# Function outside the Supabase deployment, and the deploy pipeline strips comments,
# so the deployment cannot serve as the archive of record. Reviewed before publishing:
# it contains no key material — every secret is read at runtime via Deno.env.get, and
# the rate caps it exposes are already returned to any caller in the broker's own 402
# response. Do NOT broaden this into a directory-level negation; the rest of .private/
# is genuinely private.

# Per-thread session handoff docs (local-only resume pointers; see CLAUDE.md)
handoffs/

# Generated agent output dirs — regenerated on schedule, not source (see CLAUDE.md)
# Scripts live in scripts/ and ARE tracked; only the generated findings/state/briefs are ignored.
janitor/
reviewer-review/
# Voice-guide FAQ agent — state.json + report.md are generated; the FAQ itself
# (wiki/voice_guide_faq.json) IS tracked/published. See CLAUDE.md.
voice_faq/
wiki/review/.stale_review_pages/

# Logs
*.log

# Archive snapshots
*.zip

# Claude agent state & git worktrees
.claude/

# Local macOS helper scripts
*.command

# PRS-3D staging artifact (live prs_3d.html is the published copy)
wiki/prs_3d_review.html

# Third-party full transcript — reference/link only, do not republish (Habash/Summa daily transcripts ARE kept)
wiki/inbox/hoffman_levin_transcript_raw.md

# Names private individuals — keep out of public repo
Archbishop_Wokorach_Visit_Report_April2026.md

# PETER subsystem — kept local-only for now (in-vault for Obsidian/agents, not published). Tom's call 2026-06-04.
wiki/PETER/

