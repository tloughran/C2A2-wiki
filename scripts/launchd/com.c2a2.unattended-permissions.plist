<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.c2a2.unattended-permissions</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/tomloughran/Documents/Claude/Projects/RC Karpathy Wiki Project/scripts/ensure_unattended_permissions.sh</string>
    </array>

    <!-- Re-applies permissionMode to c282-wiki-agent-daily-run, which the Claude
         desktop app strips whenever it rewrites scheduled-tasks.json from memory.
         The field can only be written while the app is NOT running, so this is a
         POLL waiting for a window, not a scheduled job with a right time to fire.

         Every 10 minutes, and at load. When the app is up the script writes
         nothing and logs DEFER, which costs a `ps` and a JSON parse. When the app
         is down — a quit, a restart, a logout, the stretch before login items
         come up — the patch lands and the app reads it at its next launch.

         RunAtLoad is the important one: at login this fires before, or alongside,
         the app starting, which is the widest window that occurs on its own. -->
    <key>StartInterval</key>
    <integer>600</integer>

    <key>RunAtLoad</key>
    <true/>

    <!-- launchd starts with a bare PATH; the script shells out to `ps`. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/tomloughran/Documents/Claude/Projects/RC Karpathy Wiki Project</string>

    <key>StandardOutPath</key>
    <string>/Users/tomloughran/Library/Logs/c2a2-unattended-permissions.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/tomloughran/Library/Logs/c2a2-unattended-permissions.log</string>
</dict>
</plist>
