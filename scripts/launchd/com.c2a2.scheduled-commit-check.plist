<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.c2a2.scheduled-commit-check</string>

  <!--
    Two assertions about the daily run, one job:
      - it committed what it produced      (scheduler/commit_check.md)
      - it finished at all, and if not,
        which tool it hung waiting on      (scheduler/run_stall.md)
    Both have to run on the Mac rather than inside a task sandbox: the registry
    and the run transcripts both live under ~/Library/Application Support/Claude,
    and the scheduled tasks only ever mount ~/Documents. morning-system-health
    reads the two status files this writes. The label predates the stall check
    and is deliberately not renamed -- a rename means a bootout/bootstrap cycle
    and a stale plist to chase, for no gain.
  -->
  <!--
    Must be /bin/bash + a wrapper, NOT /usr/bin/python3 + the .py directly.
    TCC grants ~/Documents read access per-executable; the CommandLineTools
    python3 shim does not have it under launchd, so the direct form failed every
    run with "Operation not permitted" and wrote nothing. See the header comment
    in scripts/check_scheduled_commits.sh.
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/tomloughran/Documents/Claude/Projects/RC Karpathy Wiki Project/scripts/check_scheduled_commits.sh</string>
  </array>

  <!--
    05:45 local. The daily run starts 04:30 and finishes ~04:40, so its 1h grace
    window has closed by 05:40 and the verdict is final. morning-system-health
    runs at 06:00 and reads the line written here.
  -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>   <integer>5</integer>
    <key>Minute</key> <integer>45</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/tomloughran/Library/Logs/c2a2-scheduled-commit-check.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/tomloughran/Library/Logs/c2a2-scheduled-commit-check.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
