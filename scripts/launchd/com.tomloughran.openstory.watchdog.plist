<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tomloughran.openstory.watchdog</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/tomloughran/Documents/Claude/Projects/RC Karpathy Wiki Project/scripts/openstory-watchdog.sh</string>
    </array>

    <!-- Every 5 minutes. Cheap: one curl against a local /health endpoint. -->
    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <!-- Deliberately NOT KeepAlive: this is a periodic check that exits, not a
         daemon. KeepAlive here would spin it continuously. -->

    <key>StandardOutPath</key>
    <string>/Users/tomloughran/Library/Logs/openstory-watchdog.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/tomloughran/Library/Logs/openstory-watchdog-error.log</string>
</dict>
</plist>
