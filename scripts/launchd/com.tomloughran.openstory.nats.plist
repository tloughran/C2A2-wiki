<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/tomloughran</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.tomloughran.openstory.nats</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/nats-server</string>
		<string>-c</string>
		<string>deploy/nats-local.conf</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/tomloughran/Library/Logs/openstory-nats.log</string>
	<key>StandardOutPath</key>
	<string>/Users/tomloughran/Library/Logs/openstory-nats.log</string>
	<key>WorkingDirectory</key>
	<string>/Users/tomloughran/Documents/Non-Claude Projects/OpenStory</string>
</dict>
</plist>
