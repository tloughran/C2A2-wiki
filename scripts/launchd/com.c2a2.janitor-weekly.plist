<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.c2a2.janitor-weekly</string>

    <!-- Weekly wiki janitor: runs scripts/janitor.py, which auto-fixes its safelist,
         runs its report-only checks, and writes janitor/findings.md (read directly by
         morning-system-health). Replaces the cloud routine "c2a2 wiki janitor weekly",
         a Tier 1 job (pure script) under CLAUDE.md's three-tier rule: on 2026-09-27 that
         routine did nothing because device_bash failed in a full sandbox. Bash is the
         launching executable for the ~/Documents access grant. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>cd "$HOME/Documents/Claude/Projects/RC Karpathy Wiki Project" &amp;&amp; python3 scripts/janitor.py</string>
    </array>

    <!-- Sunday 06:45 local: after metabolism-publish (Sunday 06:30, which pushes) so
         the two never overlap. Its whitespace fixes predate Monday's daily run, so the
         05:45 commit step commits them as ordinary run-window changes. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>45</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/tomloughran/Library/Logs/c2a2-janitor-weekly.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/tomloughran/Library/Logs/c2a2-janitor-weekly.log</string>
</dict>
</plist>
