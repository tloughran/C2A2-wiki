graph TD

  P0["<b>Phase 0 · Ingest & preserve</b><br/>RUNS: append_decision_email.py (idempotent) · proposal intake<br/>WRITES: provenance/decision_emails.json · inbox/proposals/<br/>GUARD: append BEFORE the ephemeral review page is deleted"]

  P1["<b>Phase 1 · Validate inputs</b><br/>RUNS: proposal parse · schema / format checks<br/>WRITES: approved / pending / needs_review routing<br/>GUARD: malformed cards held, not ingested (fail loud)"]

  P2["<b>Phase 2 · Tradition agents draft</b><br/>RUNS: 11 tradition agents read the shared vault<br/>WRITES: traditions/** · synthesis/*_bridge.md"]

  P3["<b>Phase 3 · Integrate + detect</b><br/>RUNS: Master C2A2 agent · Pattern Detector<br/>WRITES: master/cross_program_index · prs_pub_years.json · flags/pattern_detector_findings.md"]

  P4["<b>Phase 4 · Regenerate views</b><br/>RUNS: regen_summa_sociogram.sh + prs / metabolism builders<br/>WRITES: wiki_narration.html · prs_3d.html · metabolism_view.html<br/>GUARD: validate_html.py PASS + node count > 0"]

  P55["<b>Phase 5.5 · Rebuild Review Log</b><br/>RUNS: refresh_review_log.sh (build_provenance + assemble)<br/>WRITES: review_log.html (email-scrubbed)<br/>GUARD: grep-assert scrub held · size > 500 KB"]

  P6["<b>Phase 6 · Publish</b><br/>RUNS: git commit + push to main → Pages rebuild<br/>WRITES: review_log.html + day's vault changes (live)<br/>GUARD: local-HTTP visual review before any code/HTML push"]

